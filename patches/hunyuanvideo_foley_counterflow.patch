+def build_device_map(gpu_ids, default_device):
+    """Build a device map assigning each model to a GPU.
+
+    foley_model is always on GPU 0 (largest model). The remaining 4 models
+    (dac, clap, siglip2, syncformer) are spread across the other GPUs.
+
+    Distribution by number of GPUs:
+      2 GPUs: GPU0=foley          GPU1=dac,clap,siglip2,syncformer
+      3 GPUs: GPU0=foley          GPU1=dac,clap    GPU2=siglip2,syncformer
+      4 GPUs: GPU0=foley          GPU1=dac,clap    GPU2=siglip2   GPU3=syncformer
+    """
+    if not gpu_ids:
+        return {
+            'foley': default_device,
+            'dac': default_device,
+            'siglip2': default_device,
+            'clap': default_device,
+            'syncformer': default_device,
+        }
+
+    devices = [torch.device(f"cuda:{gid}") for gid in gpu_ids]
+    n = len(devices)
+
+    device_map = {'foley': devices[0]}
+
+    if n == 1:
+        for name in ['dac', 'clap', 'siglip2', 'syncformer']:
+            device_map[name] = devices[0]
+    elif n == 2:
+        for name in ['dac', 'clap', 'siglip2', 'syncformer']:
+            device_map[name] = devices[1]
+    elif n == 3:
+        device_map['dac'] = devices[1]
+        device_map['clap'] = devices[1]
+        device_map['siglip2'] = devices[2]
+        device_map['syncformer'] = devices[2]
+    else:  # 4+
+        device_map['dac'] = devices[1]
+        device_map['clap'] = devices[1]
+        device_map['siglip2'] = devices[2]
+        device_map['syncformer'] = devices[3]
+
+    return device_map
+
